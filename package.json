  "files": [
    "lib/",
    "index.js",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/chai": "^4.1.4",
    "@types/mocha": "^5.2.5",
    "chai": "^4.1.2",
    "mocha": "^5.2.0",
    "graphql": "^17.0.2",
    "ts-mocha": "^2.0.0",
    "typescript": "^4.8.2"
